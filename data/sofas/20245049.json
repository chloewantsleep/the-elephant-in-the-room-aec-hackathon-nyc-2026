        "contentProps": {
          "goodToKnow": [
            {
              "name": "Purchase-/Other information",
              "text": "The leather on this sofa will become softer and acquire a darker tone with time. This is natural for full-grain leather, which is treated with only a light surface coating for protection."
            },
            {
              "name": "Purchase-/Other information",
              "text": "Due to its unaltered surface, aniline leather can have natural marks like wrinkles and scars, color variations and be more sensitive to sunlight, dirt, liquids and scratches than leather with full coatings."
            },
            {
              "name": "Purchase-/Other information",
              "text": "Proper care keeps the aniline leather in top condition. Use the soft brush attachment on your vacuum and, if needed, wipe the surface with a slightly damp cloth."
            }
          ]
        }
