{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/",
      "destination": "/app/",
      "permanent": false
    }
  ],
  "functions": {
    "api/render.py": {
      "maxDuration": 60,
      "includeFiles": "{api/_core.py,app/assets/**,data/images/**,demo-cache/**}"
    },
    "api/detect.py": {
      "maxDuration": 60,
      "includeFiles": "{api/_core.py,app/assets/**}"
    },
    "api/isolate.py": {
      "maxDuration": 60,
      "includeFiles": "{api/_core.py,app/assets/**}"
    },
    "api/sketch.py": {
      "maxDuration": 60,
      "includeFiles": "{api/_core.py,sketch_ai.py,data/products.json}"
    },
    "api/chat.py": {
      "maxDuration": 60,
      "includeFiles": "{api/_core.py,api/_designer.py}"
    },
    "api/track.py": {
      "maxDuration": 60,
      "includeFiles": "{api/_core.py,app/assets/**,data/images/**,demo-cache/**}"
    },
    "api/recolor.py": {
      "maxDuration": 60,
      "includeFiles": "{api/_core.py,demo-cache/**}"
    },
    "api/swap.py": {
      "maxDuration": 60,
      "includeFiles": "{api/_core.py,data/images/**,demo-cache/**}"
    },
    "api/place.py": {
      "maxDuration": 60,
      "includeFiles": "{api/_core.py,data/images/**,demo-cache/**}"
    },
    "api/cached_render.py": {
      "maxDuration": 30,
      "includeFiles": "{api/_core.py,demo-cache/**}"
    }
  }
}
