{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/",
      "destination": "/app/",
      "permanent": false
    }
  ],
  "functions": {
    "api/render.py": {
      "maxDuration": 60,
      "includeFiles": "{api/_core.py,app/assets/**,data/images/**}"
    },
    "api/detect.py": {
      "maxDuration": 60,
      "includeFiles": "{api/_core.py,app/assets/**}"
    },
    "api/isolate.py": {
      "maxDuration": 60,
      "includeFiles": "{api/_core.py,app/assets/**}"
    }
  }
}
