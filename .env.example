# copy to .env and fill in
GEMINI_API_KEY=
# optional: "Guess with AI" on a sketch uses Claude if this is set (pip install anthropic), else Gemini, else free shape rules
# ANTHROPIC_API_KEY=
# optional: force a sketch reader: SKETCH_ENGINE=claude | gemini | rules
# optional: GEMINI_IMAGE_MODEL=gemini-3.1-flash-image (default) | gemini-2.5-flash-image (cheaper) | gemini-3-pro-image (best)

# Conversational intake and photo understanding (uses the same Gemini key)
GEMINI_CHAT_MODEL=gemini-3.8-flash
