# copy to .env and fill in
GEMINI_API_KEY=
# optional: "Guess with AI" on a sketch uses Claude if this is set (pip install anthropic), else Gemini, else free shape rules
# ANTHROPIC_API_KEY=
# optional: force a sketch reader: SKETCH_ENGINE=claude | gemini | rules
# Render testing: refresh the page after changing these locally.
# Initial state of the existing top-right AI renders toggle (true / false).
AI_RENDER_ENABLED=true
# true: sample lounge uses saved renders; false: allow new renders for model testing.
AI_RENDER_DEMO_CACHE_ONLY=true
# Full room / color changes / similar products / sketch placement, independently configured.
# Try gemini-3.1-flash-lite-image for cheaper color previews.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_RECOLOR_MODEL=gemini-3.1-flash-image
GEMINI_SWAP_MODEL=gemini-3.1-flash-image
GEMINI_PLACE_MODEL=gemini-3.1-flash-image

# Conversational intake and photo understanding (uses the same Gemini key)
GEMINI_CHAT_MODEL=gemini-3.8-flash
